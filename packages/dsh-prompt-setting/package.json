{
  "name": "dsh-prompt-setting",
  "version": "0.1.0",
  "description": "DeepSeek Harness 默认 System Prompt 管理插件：在 Web GUI「设置」里浏览、检索并覆盖最终装配进每轮会话的系统提示词。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zangxx66/dsh-prompt-setting.git",
    "directory": "packages/dsh-prompt-setting"
  },
  "homepage": "https://github.com/zangxx66/dsh-prompt-setting#readme",
  "bugs": {
    "url": "https://github.com/zangxx66/dsh-prompt-setting/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core",
    "client.js",
    "cordis.patch.yml",
    "CONTRACT.md",
    "README.md",
    "NOTES.md",
    "scripts"
  ],
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "check-compat": "node scripts/check-compat.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "prompt",
    "settings",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <0.2.0 || >=0.2.0-0 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
